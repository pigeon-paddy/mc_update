# Identifier for
USER_AGENT=yourname/mod-update-script/0.1 (you@example.com)
# Markdown file with one mod per line
MOD_LIST_PATH=C:/path/to/MC_Update.md
# CurseForge API key: https://console.curseforge.com
CURSEFORGE_API_KEY=
# Optional: cache file location (default ~/.cache/mod-updater/projects.json)
# MOD_CACHE=

# Optional: where the exported .md files go (default: folder of the mod list)
# OUTPUT_DIR=
